{
  "name": "reelskin",
  "private": true,
  "version": "1.0.0",
  "description": "Restyle YouTube, Twitch and streaming sites: themes, ambient light, cinema mode and player tools.",
  "license": "UNLICENSED",
  "author": "Tanx-1811 (https://github.com/Tanx-1811)",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc -b && vite build",
    "build:e2e": "vite build --mode e2e",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run build:e2e && playwright test --project=e2e --project=store-build",
    "test:live": "npm run build:e2e && playwright test --project=live",
    "screenshots": "npm run build:e2e && playwright test --project=screenshots",
    "icons": "node scripts/generate-icons.mjs",
    "brand": "node scripts/brand/render.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "package": "node scripts/third-party-notices.mjs && npm run build && node scripts/package-extension.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
